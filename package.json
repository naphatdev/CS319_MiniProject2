{
  "name": "nataui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,api -c magenta,cyan \"npm:dev\" \"npm:api\"",
    "build": "npm run prisma:generate && tsc -b && vite build",
    "typecheck": "npm run prisma:generate && tsc -b --pretty false",
    "typecheck:server": "tsc -p tsconfig.server.json --pretty false",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "capture:screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "cors": "^2.8.6",
    "daisyui": "^5.1.25",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^0.545.0",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "tailwindcss": "^4.1.14",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
